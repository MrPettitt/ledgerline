@page "/"
@using Ledgerline.Core.Alerts
@using Ledgerline.Core.Summary
@using Ledgerline.Data
@using Microsoft.EntityFrameworkCore
@inject LedgerlineDbContext Database
@inject TimeProvider Time

<PageHeader Title="Overview" Description="What you spend on subscriptions, and what needs a look." />

@if (_summary.ActiveCount == 0)
{
    <MudText Class="page-description overview-empty">
        No subscriptions yet. <MudLink Href="/import">Import a statement</MudLink> to get started.
    </MudText>
}
else
{
    <div class="stat-grid">
        <MudPaper Outlined Class="stat">
            <div class="page-description">Per month</div>
            <div class="stat-value">@_summary.MonthlyTotal.ToString("N2")</div>
        </MudPaper>
        <MudPaper Outlined Class="stat">
            <div class="page-description">Per year</div>
            <div class="stat-value">@_summary.YearlyTotal.ToString("N2")</div>
        </MudPaper>
        <MudPaper Outlined Class="stat">
            <div class="page-description">Subscriptions</div>
            <div class="stat-value">@_summary.ActiveCount</div>
            <div class="page-description">@_summary.ConfirmedCount confirmed, @_summary.SuspectedCount suspected</div>
        </MudPaper>
    </div>

    @if (_alertCount > 0)
    {
        <MudPaper Outlined Class="attention">
            <MudText>@_alertCount @(_alertCount == 1 ? "alert needs" : "alerts need") your attention.</MudText>
            <MudLink Href="/alerts">View alerts</MudLink>
        </MudPaper>
    }

    <MudText Typo="Typo.h6" Class="section-title">Most expensive</MudText>
    <MudPaper Outlined Class="list-panel">
        @foreach (var cost in _summary.MostExpensive)
        {
            <div class="list-row">
                <span>@cost.MerchantName</span>
                <span class="page-description">@cost.MonthlyCost.ToString("N2") per month</span>
            </div>
        }
    </MudPaper>

    <MudText Typo="Typo.h6" Class="section-title">Coming up in the next 30 days</MudText>
    @if (_summary.UpcomingRenewals.Count == 0)
    {
        <MudText Class="page-description">No renewals expected.</MudText>
    }
    else
    {
        <MudPaper Outlined Class="list-panel">
            @foreach (var renewal in _summary.UpcomingRenewals)
            {
                <div class="list-row">
                    <span>@renewal.MerchantName</span>
                    <span class="page-description">@renewal.Amount.ToString("N2") on @renewal.Date.ToString("yyyy-MM-dd")</span>
                </div>
            }
        </MudPaper>
    }
}

@code {
    private OverviewSummary _summary = new(0, 0, 0, 0, [], []);
    private int _alertCount;

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

        var subscriptions = await Database.Subscriptions
            .AsNoTracking()
            .Include(s => s.Merchant)
            .Include(s => s.Events)
            .ToListAsync();

        _summary = new OverviewSummaryBuilder().Build(subscriptions, today);
        _alertCount = new AlertBuilder().Build(subscriptions, today).Count;
    }
}
