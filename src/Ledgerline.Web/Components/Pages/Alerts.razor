@page "/alerts"
@using Ledgerline.Core.Alerts
@using Ledgerline.Data
@inject AlertService AlertData
@inject TimeProvider Time

<PageHeader Title="Alerts" Description="Price increases, missed charges and renewals coming up this week." />

<div class="visually-hidden" aria-live="polite">@_announcement</div>

@if (_loaded)
{
    @if (_list.Active.Count == 0)
    {
        <MudText Class="page-description alerts-empty">Nothing needs your attention.</MudText>
    }
    else
    {
        <MudPaper Outlined Class="list-panel">
            @foreach (var alert in _list.Active)
            {
                <div class="list-row">
                    <div>
                        <div class="list-title">@alert.MerchantName</div>
                        <div class="page-description">@Describe(alert)</div>
                    </div>
                    <div class="list-row-actions">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Label(alert.Kind)</MudChip>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   aria-label="@($"Dismiss {Label(alert.Kind).ToLowerInvariant()} alert for {alert.MerchantName}")"
                                   OnClick="() => DismissAsync(alert)">
                            Dismiss
                        </MudButton>
                    </div>
                </div>
            }
        </MudPaper>
    }

    @if (_list.Dismissed.Count > 0)
    {
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="section-title">Dismissed</MudText>
        <MudPaper Outlined Class="list-panel">
            @foreach (var alert in _list.Dismissed)
            {
                <div class="list-row">
                    <div>
                        <div class="list-title">@alert.MerchantName</div>
                        <div class="page-description">@Describe(alert)</div>
                    </div>
                    <div class="list-row-actions">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Label(alert.Kind)</MudChip>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   aria-label="@($"Restore {Label(alert.Kind).ToLowerInvariant()} alert for {alert.MerchantName}")"
                                   OnClick="() => RestoreAsync(alert)">
                            Restore
                        </MudButton>
                    </div>
                </div>
            }
        </MudPaper>
    }
}

@code {
    private AlertList _list = new([], []);
    private bool _loaded;
    private DateOnly _today;
    private string _announcement = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _list = await AlertData.GetAsync(_today);
        _loaded = true;
    }

    private async Task DismissAsync(Alert alert)
    {
        await AlertData.DismissAsync(alert.Key);
        await LoadAsync();
        _announcement = $"Dismissed the {Label(alert.Kind).ToLowerInvariant()} alert for {alert.MerchantName}.";
    }

    private async Task RestoreAsync(Alert alert)
    {
        await AlertData.RestoreAsync(alert.Key);
        await LoadAsync();
        _announcement = $"Restored the {Label(alert.Kind).ToLowerInvariant()} alert for {alert.MerchantName}.";
    }

    private static string Label(AlertKind kind) => kind switch
    {
        AlertKind.MissedRenewal => "Missed",
        AlertKind.PriceIncrease => "Price increase",
        _ => "Renewal"
    };

    private string Describe(Alert alert) => alert.Kind switch
    {
        AlertKind.MissedRenewal =>
            $"Expected {alert.Amount:N2} on {alert.Date:yyyy-MM-dd} but no charge was seen. It may have been cancelled.",
        AlertKind.PriceIncrease =>
            $"Went up from {alert.PreviousAmount:N2} to {alert.Amount:N2} on {alert.Date:yyyy-MM-dd}.",
        _ => $"Renews {alert.Amount:N2} on {alert.Date:yyyy-MM-dd}, {DaysAway(alert.Date)}."
    };

    private string DaysAway(DateOnly date) => (date.DayNumber - _today.DayNumber) switch
    {
        0 => "today",
        1 => "tomorrow",
        var days => $"in {days} days"
    };
}
