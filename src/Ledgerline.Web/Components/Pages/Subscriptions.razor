@page "/subscriptions"
@using Ledgerline.Core.Domain
@using Ledgerline.Data
@using Microsoft.EntityFrameworkCore
@inject LedgerlineDbContext Database

<PageHeader Title="Subscriptions" Description="Every recurring charge Ledgerline finds is listed here." />

@if (_subscriptions.Count == 0)
{
    <MudText Class="page-description subscriptions-empty">No subscriptions found yet. Import a statement to get started.</MudText>
}
else
{
    <MudPaper Outlined Class="subscriptions-table">
        <MudTable Items="_subscriptions" Elevation="0" Hover="true" Dense="false">
            <HeaderContent>
                <MudTh>Merchant</MudTh>
                <MudTh Style="text-align: right">Amount</MudTh>
                <MudTh>Billed</MudTh>
                <MudTh>Next expected</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Notes</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Merchant?.DisplayName</MudTd>
                <MudTd Style="text-align: right">@context.CurrentAmount.ToString("N2")</MudTd>
                <MudTd>@context.Cadence</MudTd>
                <MudTd>@context.NextExpectedDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.Status == SubscriptionStatus.Confirmed ? Color.Primary : Color.Default)">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd>@Note(context)</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<Subscription> _subscriptions = [];

    protected override async Task OnInitializedAsync()
    {
        var subscriptions = await Database.Subscriptions
            .AsNoTracking()
            .Include(s => s.Merchant)
            .Include(s => s.Events)
            .ToListAsync();

        // SQLite cannot order decimals, and the list is small.
        _subscriptions = subscriptions.OrderByDescending(s => s.CurrentAmount).ToList();
    }

    private static string Note(Subscription subscription)
    {
        var missed = subscription.Events.Where(e => e.Type == SubscriptionEventType.Missed).MaxBy(e => e.OccurredOn);
        if (missed is not null)
        {
            return $"No charge seen since {missed.OccurredOn:yyyy-MM-dd}";
        }

        var change = subscription.Events.Where(e => e.Type == SubscriptionEventType.PriceChange).MaxBy(e => e.OccurredOn);
        return change is null ? string.Empty : $"Price changed from {change.PreviousAmount:N2} to {change.Amount:N2} on {change.OccurredOn:yyyy-MM-dd}";
    }
}
