@page "/subscriptions"
@using Ledgerline.Core.Domain
@using Ledgerline.Data
@using Microsoft.EntityFrameworkCore
@inject LedgerlineDbContext Database
@inject SubscriptionStatusService Statuses

<PageHeader Title="Subscriptions" Description="Every recurring charge Ledgerline finds is listed here." />

@if (_subscriptions.Count == 0)
{
    <MudText Class="page-description subscriptions-empty">No subscriptions found yet. Import a statement to get started.</MudText>
}
else
{
    <MudPaper Outlined Class="table-panel">
        <MudTable Items="_subscriptions" Elevation="0" Hover="true" Dense="false" RowClassFunc="RowClass" Breakpoint="Breakpoint.Md">
            <HeaderContent>
                <MudTh>Merchant</MudTh>
                <MudTh Style="text-align: right">Amount</MudTh>
                <MudTh>Billed</MudTh>
                <MudTh>Next expected</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Notes</MudTh>
                <MudTh><span class="visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Merchant">@context.Merchant?.DisplayName</MudTd>
                <MudTd DataLabel="Amount" Style="text-align: right">@context.CurrentAmount.ToString("N2")</MudTd>
                <MudTd DataLabel="Billed">@context.Cadence</MudTd>
                <MudTd DataLabel="Next expected" Style="white-space: nowrap">@context.NextExpectedDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.Status == SubscriptionStatus.Confirmed ? Color.Primary : Color.Default)">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Notes">@Note(context)</MudTd>
                <MudTd>
                    <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" AriaLabel="@($"Actions for {context.Merchant?.DisplayName}")">
                        @foreach (var status in Enum.GetValues<SubscriptionStatus>().Where(s => s != context.Status))
                        {
                            var subscription = context;
                            var target = status;
                            <MudMenuItem OnClick="() => SetStatus(subscription, target)">@ActionLabel(target)</MudMenuItem>
                        }
                    </MudMenu>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<Subscription> _subscriptions = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var subscriptions = await Database.Subscriptions
            .AsNoTracking()
            .Include(s => s.Merchant)
            .Include(s => s.Events)
            .ToListAsync();

        // SQLite cannot order decimals, and the list is small.
        _subscriptions = subscriptions.OrderByDescending(s => s.CurrentAmount).ToList();
    }

    private async Task SetStatus(Subscription subscription, SubscriptionStatus status)
    {
        await Statuses.SetStatusAsync(subscription.Id, status);
        await LoadAsync();
    }

    private static string RowClass(Subscription subscription, int index) =>
        subscription.Status is SubscriptionStatus.Ignored or SubscriptionStatus.Cancelled ? "row-inactive" : string.Empty;

    private static string ActionLabel(SubscriptionStatus status) => status switch
    {
        SubscriptionStatus.Confirmed => "Confirm",
        SubscriptionStatus.Ignored => "Ignore",
        SubscriptionStatus.Cancelled => "Mark as cancelled",
        _ => "Mark as suspected"
    };

    private static string Note(Subscription subscription)
    {
        var missed = subscription.Events.Where(e => e.Type == SubscriptionEventType.Missed).MaxBy(e => e.OccurredOn);
        if (missed is not null)
        {
            return $"No charge seen since {missed.OccurredOn:yyyy-MM-dd}";
        }

        var change = subscription.Events.Where(e => e.Type == SubscriptionEventType.PriceChange).MaxBy(e => e.OccurredOn);
        return change is null ? string.Empty : $"Price changed from {change.PreviousAmount:N2} to {change.Amount:N2} on {change.OccurredOn:yyyy-MM-dd}";
    }
}
