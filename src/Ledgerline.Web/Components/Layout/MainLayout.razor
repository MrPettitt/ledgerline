@inherits LayoutComponentBase
@using Ledgerline.Data
@inject AppSettingsService Settings

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />

<a class="skip-link" href="#main-content">Skip to main content</a>

<MudLayout>
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" Class="app-drawer">
        <div class="app-brand">Ledgerline</div>
        <NavMenu />
        <div class="app-drawer-footer">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           Size="Size.Small"
                           aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                           OnClick="ToggleDarkMode" />
        </div>
    </MudDrawer>

    <MudMainContent>
        <main id="main-content" class="app-page" tabindex="-1">
            @Body

            <MudPopoverProvider />
            <MudDialogProvider />
            <MudSnackbarProvider />
        </main>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href=".">Reload</a>
</div>

@code {
    private readonly MudTheme _theme = LedgerlineTheme.Create();
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync() => _isDarkMode = await Settings.GetDarkModeAsync();

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await Settings.SetDarkModeAsync(_isDarkMode);
    }
}
